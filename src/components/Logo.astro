---
// The Wappclaw lockup: the dark app-icon tile plus the "wapp" + "claw" wordmark.
export interface Props { size?: number; }
const { size = 38 } = Astro.props;
---

<span class="logo" style={`--logo-size:${size}px`}>
  <img src="/favicon.svg" alt="" width={size} height={size} class="tile" />
  <span class="word"><span class="wapp">wapp</span><span class="claw">claw</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-size) * 0.32); }
  .tile {
    width: var(--logo-size); height: var(--logo-size);
    border-radius: calc(var(--logo-size) * 0.22);
    box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.35), 0 4px 14px rgba(0, 174, 219, 0.3);
  }
  .word {
    font-family: 'Poppins', var(--font);
    font-weight: 600;
    font-size: calc(var(--logo-size) * 0.72);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .wapp { color: var(--text); }
  .claw {
    background: linear-gradient(90deg, #00aedb, #00e5c8);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
</style>
