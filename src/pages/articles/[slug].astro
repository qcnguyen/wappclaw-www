---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, type Article } from '../../data/articles';
import { site, SITE_URL } from '../../data/site';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props { article: Article; }
const { article } = Astro.props;
const url = `${SITE_URL}/articles/${article.slug}`;
const date = new Date(article.date + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: article.title,
      description: article.excerpt,
      url,
      datePublished: article.date,
      author: { '@type': 'Organization', name: article.author },
      publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo-512.png` } },
      keywords: article.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Articles', item: `${SITE_URL}/articles` },
        { '@type': 'ListItem', position: 3, name: article.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${article.title} — ${site.name}`}
  description={article.excerpt}
  ogType="article"
  publishedTime={article.date}
  keywords={article.tags.join(', ')}
  structuredData={structuredData}
>
  <article class="page-hero">
    <div class="container prose-wrap">
      <a href="/articles" class="back">← All articles</a>
      <h1>{article.title}</h1>
      <p class="meta"><time datetime={article.date}>{date}</time> · {article.author}</p>
      <div class="prose" set:html={article.content} />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-wrap { max-width: 50rem; }
  h1 { font-size: clamp(2rem, 4.2vw, 3rem); }
  .back { display: inline-block; margin-bottom: 1.5rem; font-size: 0.9rem; }
  .meta { color: var(--muted); margin-bottom: 2.5rem; }
</style>
